# im-human — Neo4j connection settings
# Copy to .env and fill in real values
# NEVER commit .env to git

# Human database (primary)
NEO4J_URI=bolt://your-server:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=Human

# Mortality KB — имя базы данных (URI/user/password те же, что для Human)
# Добавьте эту строку в .neo4j/.env для активации cross-reference запросов
MORTALITY_DATABASE=Mortality

# Mortality KB (read-only, cross-references)
MORTALITY_NEO4J_URI=bolt://your-server:7687
MORTALITY_NEO4J_USER=neo4j
MORTALITY_NEO4J_PASSWORD=your_password_here
MORTALITY_NEO4J_DATABASE=Mortality
